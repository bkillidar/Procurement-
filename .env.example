# Copy to .env.local and fill in.
# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import from client components. Add to Vercel as a normal variable.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
