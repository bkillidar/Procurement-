# Copy to .env.local and fill in. Both values are safe for the browser
# (the publishable key only grants what Row Level Security allows).
# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# NEVER put a service_role / secret key in a NEXT_PUBLIC_ variable.
# If one is ever needed (server-only jobs), name it SUPABASE_SECRET_KEY,
# add it only to Vercel/.env.local, and import it only in server code.
